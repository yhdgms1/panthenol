  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {},
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.yhdgms1.panthenol.PanthenolFabric"
    ]
  },
